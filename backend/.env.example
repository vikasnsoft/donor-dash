# Server
NODE_ENV=development
PORT=5001

# Database
MONGO_URI=mongodb://localhost:27017/donor-dash

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Redis (optional — enable when ready)
# REDIS_URL=redis://localhost:6379

# Sentry (optional — enable for error tracking)
# SENTRY_DSN=https://...@sentry.io/...

# Supabase Storage (optional — for file uploads)
# SUPABASE_URL=https://...
# SUPABASE_ANON_KEY=...

# SMTP / Mailpit (for development email)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@donordash.com

# Google Cloud Vision (optional — for OCR)
# GOOGLE_CLOUD_VISION_API_KEY=...

# Plaid (optional — for bank connections)
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...
# PLAID_ENV=sandbox
