{
  "name": "donor-dash",
  "version": "2.0.0",
  "type": "module",
  "description": "Community Finance Platform for events, donations, collections, and shared expenses",
  "main": "server.js",
  "scripts": {
    "server": "nodemon --env-file=./backend/.env backend/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix frontend",
    "data:import": "node --env-file=./backend/.env backend/seeders/index.js",
    "data:destroy": "node --env-file=./backend/.env backend/seeders/index.js -d",
    "data:import:users": "node --env-file=./backend/.env backend/seeders/users.js",
    "data:destroy:users": "node --env-file=./backend/.env backend/seeders/users.js -d",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "check": "npm run lint --prefix frontend && npm run typecheck --prefix frontend",
    "clean": "rm -rf frontend/.next"
  },
  "author": "Vikas Satpute",
  "license": "MIT",
  "dependencies": {
    "@dietrichgebert/ponytail": "^4.8.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.10"
  }
}
